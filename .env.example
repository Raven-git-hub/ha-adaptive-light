# Copy to .env and fill in. docker compose reads it automatically.

# Home Assistant base URL - no trailing slash
AL_HA_URL=http://192.168.1.251:8123

# Profile -> Security -> Long-lived access tokens -> Create token
AL_HA_TOKEN=paste-your-long-lived-token-here

# Set false for a self-signed certificate
AL_HA_VERIFY_SSL=false

# Affects log timestamps only
TZ=Asia/Singapore

AL_LOG_LEVEL=info
